generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum Role {
  GUEST
  USER
  MODERATOR
  ADMIN
}

enum ImportanceLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReliabilityStatus {
  UNVERIFIED
  VERIFIED
  DISPUTED
  RETRACTED
}

enum ContentStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum NotificationType {
  REPLY
  MENTION
  NEWS_ALERT
  SYSTEM
  MODERATION
  UPVOTE
  PRICE_ALERT
  ECONOMIC_EVENT
  PORTFOLIO_ALERT
  ADMIN_MESSAGE
  PROFILE_CHANGE
  NEW_REGISTRATION
  SUPPORT_MESSAGE
}

enum AssetCategory {
  STOCKS
  FOREX
  CRYPTO
  COMMODITIES
  INDICES
}

enum AlertType {
  PRICE_CROSS_ABOVE
  PRICE_CROSS_BELOW
  PERCENT_CHANGE
  VOLATILITY_SPIKE
  NEWS_MENTION
}

enum AlertChannel {
  IN_APP
  EMAIL
  BOTH
}

enum EconomicEventType {
  CPI
  NFP
  FOMC
  GDP
  UNEMPLOYMENT
  OTHER
}

enum EventImpact {
  LOW
  MEDIUM
  HIGH
}

enum InterestCategory {
  FOREX
  STOCKS
  CRYPTO
  COMMODITIES
  FUTURES
  MACROECONOMICS
}

enum PostCategory {
  FOREX
  STOCKS
  CRYPTO
  MACRO
  RISK_MANAGEMENT
  TRADING_PSYCHOLOGY
}

enum AuditAction {
  USER_SUSPEND
  USER_BAN
  USER_UNBAN
  USER_ROLE_CHANGE
  USER_PROFILE_UPDATE
  CONTENT_APPROVE
  CONTENT_REJECT
  CONTENT_DELETE
  CONTENT_FEATURE
  NEWS_CREATE
  NEWS_UPDATE
  NEWS_DELETE
  REPORT_RESOLVE
  SETTINGS_UPDATE
  MAINTENANCE_TOGGLE
  FEATURE_FLAG_TOGGLE
}

enum PreferredMarket {
  CRYPTO
  FOREX
  STOCKS
  COMMODITIES
}

enum AdminPresenceStatus {
  ONLINE
  OFFLINE
  DND
}

enum FeedbackType {
  CONTACT
  FEEDBACK
  BUG
  SUGGESTION
}

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  REPLIED
  CLOSED
}

enum SupportMessageStatus {
  SENT
  DELIVERED
  READ
}

enum CommunityStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum CommunityMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

enum CommunityMembershipStatus {
  ACTIVE
  BLOCKED
  REMOVED
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  IGNORED
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  username             String?   @unique
  passwordHash         String?
  name                 String
  role                 Role      @default(USER)
  avatar               String?
  bio                  String?
  dateOfBirth          DateTime?
  country              String?
  timezone             String?   @default("UTC")
  preferredLanguage    String?   @default("en")
  onboardingCompleted  Boolean   @default(false)
  emailVerified        DateTime?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  twoFactorRecoveryCodes String?
  twoFactorLastVerifiedAt DateTime?
  reputation           Int       @default(0)
  contributionCount    Int       @default(0)
  isSuspended          Boolean   @default(false)
  isBanned             Boolean   @default(false)
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  sessions             Session[]
  oauthAccounts        OAuthAccount[]
  passwordResetTokens  PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  interests            UserInterest[]
  articles             Article[]
  discussions          Discussion[]
  comments             Comment[]
  bookmarks            Bookmark[]
  watchlists           Watchlist[]
  notifications        Notification[]
  reports              Report[]          @relation("Reporter")
  auditLogs            AuditLog[]
  activities           UserActivity[]
  badges               UserBadge[]
  articleLikes         ArticleLike[]
  discussionVotes      DiscussionVote[]
  aiConversations      AIConversation[]
  newsCreated          News[]            @relation("NewsCreator")
  alertRules           AlertRule[]
  priceAlerts          PriceAlert[]
  portfolios           Portfolio[]
  preferences          UserPreferences?
  notificationSettings NotificationSettings?
  favoriteAssets       FavoriteAsset[]
  registrationAudit    RegistrationAudit?
  supportConversations SupportConversation[] @relation("UserSupport")
  feedbackSubmissions  FeedbackSubmission[]
  adminPresence        AdminPresence?
  puterTokensCreated   PuterToken[]      @relation("PuterTokenCreator")
  trustedDevices       TrustedDevice[]
  visitorActivities    VisitorActivity[]
  ownedCommunities     TradeCommunity[]  @relation("CommunityOwner")
  approvedCommunities  TradeCommunity[]  @relation("CommunityApprover")
  communityMemberships CommunityMembership[]
  communityMessages    CommunityMessage[]
  sentFriendRequests   FriendRequest[]   @relation("FriendRequester")
  receivedFriendRequests FriendRequest[] @relation("FriendRecipient")
  dmParticipants       DirectConversationParticipant[]
  directMessages       DirectMessage[]

  @@index([email])
  @@index([username])
  @@index([role])
  @@index([deletedAt])
}

model TrustedDevice {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  deviceName String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model NewsSource {
  id               String   @id @default(cuid())
  name             String   @unique
  url              String?
  reliabilityScore Float    @default(0.5)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  news News[]
}

model NewsCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  news News[]
}

model News {
  id                String            @id @default(cuid())
  headline          String
  summary           String?
  content           String?
  sourceId          String
  categoryId        String?
  importance        ImportanceLevel   @default(MEDIUM)
  reliabilityStatus ReliabilityStatus @default(UNVERIFIED)
  aiInterpretation  Json?
  publishedAt       DateTime          @default(now())
  createdById       String?
  externalId        String?
  providerName      String?
  sourceUrl         String?
  imageUrl          String?
  isPinned          Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  source     NewsSource    @relation(fields: [sourceId], references: [id])
  category   NewsCategory? @relation(fields: [categoryId], references: [id])
  createdBy  User?         @relation("NewsCreator", fields: [createdById], references: [id])
  assets     NewsAsset[]
  bookmarks  Bookmark[]
  comments   Comment[]

  @@unique([providerName, externalId])
  @@index([publishedAt])
  @@index([importance])
  @@index([sourceId])
  @@index([categoryId])
  @@index([isPinned])
}

model NewsAsset {
  id       String @id @default(cuid())
  newsId   String
  symbol   String
  assetType String

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@index([newsId])
  @@index([symbol])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  articles ArticleTag[]
}

model Article {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  content     String
  excerpt     String?
  authorId    String
  category    PostCategory
  status      ContentStatus @default(PENDING)
  featured    Boolean       @default(false)
  viewCount   Int           @default(0)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  author    User         @relation(fields: [authorId], references: [id])
  tags      ArticleTag[]
  likes     ArticleLike[]
  bookmarks Bookmark[]
  comments  Comment[]

  @@index([authorId])
  @@index([status])
  @@index([category])
  @@index([publishedAt])
  @@index([status, publishedAt])
  @@index([status, featured, publishedAt])
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model ArticleLike {
  userId    String
  articleId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
}

model Discussion {
  id          String       @id @default(cuid())
  title       String
  content     String
  authorId    String
  category    PostCategory
  upvoteCount Int          @default(0)
  downvoteCount Int        @default(0)
  isPinned    Boolean      @default(false)
  isLocked    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  author   User             @relation(fields: [authorId], references: [id])
  comments Comment[]
  votes    DiscussionVote[]

  @@index([authorId])
  @@index([createdAt])
  @@index([category])
  @@index([upvoteCount])
}

model DiscussionVote {
  userId       String
  discussionId String
  value        Int
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@id([userId, discussionId])
}

model Comment {
  id           String   @id @default(cuid())
  content      String
  authorId     String
  newsId       String?
  articleId    String?
  discussionId String?
  parentId     String?
  isRemoved    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author     User        @relation(fields: [authorId], references: [id])
  news       News?       @relation(fields: [newsId], references: [id], onDelete: Cascade)
  article    Article?    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  discussion Discussion? @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  parent     Comment?    @relation("CommentReplies", fields: [parentId], references: [id])
  replies    Comment[]   @relation("CommentReplies")

  @@index([authorId])
  @@index([newsId])
  @@index([articleId])
  @@index([discussionId])
  @@index([parentId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  newsId    String?
  articleId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  news    News?    @relation(fields: [newsId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, newsId])
  @@unique([userId, articleId])
  @@index([userId])
}

model Watchlist {
  id        String         @id @default(cuid())
  userId    String
  name      String
  category  AssetCategory?
  sortOrder Int            @default(0)
  assets    Json           @default("[]")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]
  alerts PriceAlert[]

  @@index([userId])
  @@index([userId, sortOrder])
}

model WatchlistItem {
  id          String        @id @default(cuid())
  watchlistId String
  symbol      String
  assetType   String
  category    AssetCategory @default(STOCKS)
  sortOrder   Int           @default(0)
  addedAt     DateTime      @default(now())

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbol, assetType])
  @@index([watchlistId, sortOrder])
  @@index([symbol])
}

model PriceAlert {
  id          String        @id @default(cuid())
  userId      String
  watchlistId String?
  symbol      String
  assetType   String
  alertType   AlertType
  threshold   Float?
  keyword     String?
  channels    AlertChannel  @default(IN_APP)
  isActive    Boolean       @default(true)
  triggeredAt DateTime?
  createdAt   DateTime      @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchlist Watchlist? @relation(fields: [watchlistId], references: [id], onDelete: SetNull)

  @@index([userId, isActive])
  @@index([symbol, assetType])
}

model AlertRule {
  id              String       @id @default(cuid())
  userId          String
  name            String
  symbol          String?
  assetType       String?
  alertType       AlertType
  threshold       Float?
  keyword         String?
  channels        AlertChannel @default(IN_APP)
  isActive        Boolean      @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model EconomicEvent {
  id          String            @id @default(cuid())
  type        EconomicEventType
  title       String
  country     String            @default("US")
  scheduledAt DateTime
  impact      EventImpact       @default(MEDIUM)
  previous    String?
  forecast    String?
  actual      String?
  timezone    String            @default("America/New_York")
  createdAt   DateTime          @default(now())

  @@index([scheduledAt])
  @@index([type])
  @@index([impact])
}

model Portfolio {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("Main Portfolio")
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions PortfolioPosition[]

  @@unique([userId, name])
  @@index([userId])
}

model PortfolioPosition {
  id          String   @id @default(cuid())
  portfolioId String
  symbol      String
  assetType   String
  category    AssetCategory @default(STOCKS)
  quantity    Float
  entryPrice  Float
  entryDate   DateTime @default(now())
  notes       String?

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([symbol])
}

model PriceHistory {
  id        String   @id @default(cuid())
  symbol    String
  assetType String
  price     Float
  volume    Float?
  high      Float?
  low       Float?
  open      Float?
  close     Float?
  timestamp DateTime @default(now())

  @@index([symbol, assetType, timestamp])
  @@index([symbol, timestamp])
}

model AssetProfile {
  id          String        @id @default(cuid())
  slug        String        @unique
  symbol      String
  assetType   String
  category    AssetCategory
  name        String
  description String?

  @@unique([symbol, assetType])
  @@index([category])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([userId, read])
  @@index([createdAt])
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  targetType   String
  targetId     String
  reason       String
  description  String?
  status       ReportStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id])

  @@index([status])
  @@index([targetType, targetId])
}

model AuditLog {
  id         String      @id @default(cuid())
  adminId    String
  action     AuditAction
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model FeatureFlag {
  id        String   @id @default(cuid())
  key       String   @unique
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model UserInterest {
  id       String           @id @default(cuid())
  userId   String
  category InterestCategory

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model VisitorActivity {
  id         String   @id @default(cuid())
  visitorId  String
  userId     String?
  action     String
  path       String?
  target     String?
  ipAddress  String?
  country    String?
  region     String?
  city       String?
  timezone   String?
  browser    String?
  os         String?
  deviceType String?
  userAgent  String?
  vpnDetected Boolean  @default(false)
  vpnProvider String?
  ipAsn      String?
  ipCompany  String?
  ipRiskSource String?
  ipRiskCheckedAt DateTime?
  ipRisk     Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([visitorId])
  @@index([userId])
  @@index([createdAt])
  @@index([visitorId, createdAt])
  @@index([userId, createdAt])
  @@index([visitorId, action])
  @@index([userId, action])
  @@index([vpnDetected])
}

model Badge {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  icon        String
  createdAt   DateTime @default(now())

  users UserBadge[]
}

model UserBadge {
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New Conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId])
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  sources        Json?
  tokenCount     Int?
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model MarketQuote {
  id            String   @id @default(cuid())
  symbol        String
  assetType     String
  name          String?
  price         Float
  change        Float?
  changePercent Float?
  providerName  String?
  updatedAt     DateTime @updatedAt

  @@unique([symbol, assetType])
  @@index([assetType])
}

model IngestionLog {
  id             String    @id @default(cuid())
  provider       String
  status         String
  itemsProcessed Int       @default(0)
  itemsSkipped   Int       @default(0)
  errorMessage   String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([provider])
  @@index([startedAt])
}

model AIUsageLog {
  id             String   @id @default(cuid())
  userId         String
  conversationId String?
  promptTokens   Int      @default(0)
  completionTokens Int    @default(0)
  model          String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model PuterToken {
  id             String   @id @default(cuid())
  displayName    String
  token          String
  selectedModels Json     @default("[]")
  isActive       Boolean  @default(true)
  isExhausted    Boolean  @default(false)
  requestLimit   Int      @default(1000)
  requestCount   Int      @default(0)
  successCount   Int      @default(0)
  failureCount   Int      @default(0)
  lastUsedAt     DateTime?
  lastError      String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy User? @relation("PuterTokenCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive, isExhausted])
  @@index([lastUsedAt])
  @@index([createdAt])
}

model UserPreferences {
  id              String          @id @default(cuid())
  userId          String          @unique
  preferredMarket PreferredMarket @default(STOCKS)
  theme           String          @default("dark")
  chartInterval   String          @default("1H")
  defaultSymbol   String?         @default("BTC/USD")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationSettings {
  id                String  @id @default(cuid())
  userId            String  @unique
  emailEnabled      Boolean @default(true)
  pushEnabled       Boolean @default(true)
  inAppEnabled      Boolean @default(true)
  priceAlerts       Boolean @default(true)
  newsAlerts        Boolean @default(true)
  adminMessages     Boolean @default(true)
  profileChanges    Boolean @default(true)
  systemAnnounce    Boolean @default(true)
  marketingEmails   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FavoriteAsset {
  id        String        @id @default(cuid())
  userId    String
  symbol    String
  assetType String
  category  AssetCategory @default(STOCKS)
  sortOrder Int           @default(0)
  addedAt   DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol, assetType])
  @@index([userId, sortOrder])
}

model RegistrationAudit {
  id           String   @id @default(cuid())
  userId       String   @unique
  ipAddress    String?
  country      String?
  city         String?
  browser      String?
  deviceType   String?
  os           String?
  userAgent    String?
  vpnDetected Boolean  @default(false)
  vpnProvider String?
  ipAsn       String?
  ipCompany   String?
  ipRiskSource String?
  ipRiskCheckedAt DateTime?
  ipRisk      Json?
  adminViewed  Boolean  @default(false)
  registeredAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([registeredAt])
  @@index([adminViewed])
  @@index([country])
  @@index([vpnDetected])
}

model FeedbackSubmission {
  id        String         @id @default(cuid())
  userId    String?
  type      FeedbackType   @default(CONTACT)
  name      String
  email     String
  subject   String
  message   String
  status    FeedbackStatus @default(NEW)
  adminReply String?
  repliedAt DateTime?
  createdAt DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model SupportConversation {
  id        String   @id @default(cuid())
  userId    String
  subject   String   @default("Support")
  isOpen    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation("UserSupport", fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId])
  @@index([isOpen])
}

model SupportMessage {
  id             String               @id @default(cuid())
  conversationId String
  senderId       String
  isAdmin        Boolean              @default(false)
  content        String
  attachmentUrl  String?
  status         SupportMessageStatus @default(SENT)
  createdAt      DateTime             @default(now())

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model TradeCommunity {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  topic           String
  rules           String
  avatarUrl       String?
  badgeUrl        String?
  ownerId         String
  status          CommunityStatus @default(PENDING)
  rejectionReason String?
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  owner      User                   @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  approvedBy User?                  @relation("CommunityApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  members    CommunityMembership[]
  messages   CommunityMessage[]

  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model CommunityMembership {
  id             String                    @id @default(cuid())
  communityId    String
  userId         String
  role           CommunityMemberRole       @default(MEMBER)
  status         CommunityMembershipStatus @default(ACTIVE)
  rulesAgreedAt  DateTime?
  blockedAt      DateTime?
  blockedReason  String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  community TradeCommunity @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId, status])
  @@index([communityId, status])
  @@index([role])
}

model CommunityMessage {
  id             String    @id @default(cuid())
  communityId    String
  senderId       String
  content        String?
  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  attachmentSize Int?
  replyToId      String?
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  community TradeCommunity    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  sender    User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo   CommunityMessage? @relation("CommunityMessageReplies", fields: [replyToId], references: [id])
  replies   CommunityMessage[] @relation("CommunityMessageReplies")

  @@index([communityId, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@index([deletedAt])
}

model FriendRequest {
  id          String              @id @default(cuid())
  requesterId String
  recipientId String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("FriendRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([requesterId, recipientId])
  @@index([requesterId, createdAt])
  @@index([recipientId, status])
}

model DirectConversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants DirectConversationParticipant[]
  messages     DirectMessage[]

  @@index([updatedAt])
}

model DirectConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  createdAt      DateTime @default(now())

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model DirectMessage {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String?
  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  attachmentSize Int?
  replyToId      String?
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User               @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      DirectMessage?     @relation("DirectMessageReplies", fields: [replyToId], references: [id])
  replies      DirectMessage[]    @relation("DirectMessageReplies")

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@index([deletedAt])
}

model AdminPresence {
  id        String              @id @default(cuid())
  adminId   String              @unique
  status    AdminPresenceStatus @default(OFFLINE)
  updatedAt DateTime            @updatedAt

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model ChatSettings {
  id              String @id @default(cuid())
  welcomeMessage  String @default("Welcome to TRADX support! How can we help you today?")
  offlineMessage  String @default("Our team is currently offline. Leave a message and we'll respond soon.")
  updatedAt       DateTime @updatedAt
}
