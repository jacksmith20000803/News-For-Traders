# Database — Neon PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_NAME="TRADX"

# Security - Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-32-char-secret-key"
CSRF_SECRET="change-me-to-another-random-secret-key"
AUTH_SECRET="change-me-auth-secret-for-nextauth"

# Cron ingestion (production)
CRON_SECRET="change-me-cron-secret"

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Live data providers (configure at least one)
FINNHUB_API_KEY=""
ALPHAVANTAGE_API_KEY=""
POLYGON_API_KEY=""
TWELVEDATA_API_KEY=""

# IP intelligence / VPN detection
# Default provider: ipapi.is. The free tier allows 1,000 requests/day.
IP_API_KEY=""
IP_INTELLIGENCE_BASE_URL="https://api.ipapi.is"
IP_INTELLIGENCE_TIMEOUT_MS="1200"

# AI provider
# Puter.js is used directly in the browser through puter.ai.chat(...).
# No server-side AI key or backend AI proxy is required.

# Email verification via SMTP / QQ Mail (optional but recommended)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_PASSWORD=""
EMAIL_FROM="TRADX <noreply@marketpulse.com>"

# Rate limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"
AUTH_RATE_LIMIT_MAX="5"

TRUST_PROXY="false"
MAINTENANCE_MODE="false"
