ALPHAVANTAGE_API_KEY=""
POLYGON_API_KEY=""
TWELVEDATA_API_KEY=""

# AI provider (OpenAI-compatible)
OPENAI_API_KEY="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"
